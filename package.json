{
  "name": "spotcast",
  "version": "0.1.0",
  "description": "Automated local business discovery via Google Maps",
  "author": "Alessandro De Prato & Gabriela Belmani",
  "license": "MIT",
  "main": "dist/SpotCast.js",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/SpotCast.js",
    "reset": "node dist/SpotCast.js --reset",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "handlebars": "^4.7.9",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.0",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}